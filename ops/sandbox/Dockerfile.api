FROM maven:3.9.9-eclipse-temurin-17 AS builder
WORKDIR /workspace
COPY apps/api/pom.xml apps/api/pom.xml
RUN mvn -f apps/api/pom.xml -DskipTests dependency:go-offline
COPY apps/api apps/api
RUN mvn -f apps/api/pom.xml -Dmaven.test.skip=true package

FROM eclipse-temurin:17-jre-jammy
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends wget \
    && rm -rf /var/lib/apt/lists/* \
    && addgroup --system beike && adduser --system --ingroup beike beike \
    && mkdir -p /app/uploads /app/logs \
    && chown -R beike:beike /app
COPY --from=builder /workspace/apps/api/target/beike-platform-monolith-*.jar /app/app.jar
USER beike
EXPOSE 8080
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=75", "-jar", "/app/app.jar"]
