FROM node:22-alpine AS builder
WORKDIR /workspace
COPY package.json pnpm-lock.yaml ./
RUN corepack enable && pnpm config set registry https://registry.npmmirror.com && pnpm install --frozen-lockfile
COPY apps/web apps/web
COPY vite.config.ts tsconfig.json tsconfig.app.json tsconfig.node.json tailwind.config.js postcss.config.js ./
RUN pnpm build

FROM nginx:1.27-alpine
COPY ops/sandbox/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /workspace/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
