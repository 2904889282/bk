# ============================================================
# Spring Cloud Gateway Dockerfile
# ============================================================
FROM eclipse-temurin:21-jre-alpine AS runtime
RUN addgroup -S beike && adduser -S beike -G beike
WORKDIR /app
COPY gateway/scg/target/*.jar app.jar
USER beike
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=3s --retries=3 \
  CMD wget -qO- http://localhost:8080/actuator/health | grep -q UP || exit 1
ENTRYPOINT ["java","-Xms256m","-Xmx512m","-XX:+UseZGC","-XX:MaxRAMPercentage=75.0","-jar","app.jar"]
