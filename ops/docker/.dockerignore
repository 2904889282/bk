# ================================
# Docker 构建忽略文件
# ================================

# 依赖
node_modules/
.pnpm-store/

# 构建产物
dist/
build/
target/

# IDE
.vscode/
.idea/
*.iml

# Git
.git/
.gitignore
.gitattributes
.gitmodules

# 文档（构建不需要）
docs/
reference/
*.md

# 环境变量（不要打进镜像）
.env
.env.local
.env.production

# 日志
*.log
logs/

# 上传文件
uploads/

# OS
.DS_Store
Thumbs.db

# 临时文件
*.tmp
*.swp
*.bak
