<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.beike.platform.mapper.PipelineMapper">

    <select id="selectPageWithFilter" resultType="com.beike.platform.entity.Pipeline">
        SELECT
            p.id, p.name, p.customer, p.stage, p.amount, p.win_rate,
            p.owner_id, p.dept_id, p.is_sea, p.description, p.next_action,
            p.create_time, p.update_time
        FROM biz_pipeline p
        <where>
            p.is_deleted = 0
            <if test="dto.keyword != null and dto.keyword != ''">
                AND (p.name LIKE CONCAT('%', #{dto.keyword}, '%')
                     OR p.customer LIKE CONCAT('%', #{dto.keyword}, '%'))
            </if>
            <if test="dto.stage != null and dto.stage != ''">
                AND p.stage = #{dto.stage}
            </if>
            <if test="dto.owner != null and dto.owner != ''">
                AND p.owner_id = #{dto.owner}
            </if>
            <if test="dto.customer != null and dto.customer != ''">
                AND p.customer LIKE CONCAT('%', #{dto.customer}, '%')
            </if>
            <if test="dto.dateFrom != null and dto.dateFrom != ''">
                AND p.create_time &gt;= #{dto.dateFrom}
            </if>
            <if test="dto.dateTo != null and dto.dateTo != ''">
                AND p.create_time &lt;= #{dto.dateTo}
            </if>
            <!-- 数据权限 WHERE 条件由 DataPermissionInterceptor 自动追加，业务 SQL 无需关心 -->
            <!-- 例如普通员工查询时，拦截器自动追加：
                 AND (p.owner_id = 1001 OR p.id IN (SELECT pipeline_id FROM biz_pipeline_member WHERE user_id = 1001))
                 AND p.is_sea = 0
            -->
        </where>
        ORDER BY p.create_time DESC
    </select>

</mapper>
