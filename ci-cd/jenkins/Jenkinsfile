// ============================================================
// Jenkins Pipeline (Jenkinsfile) — 贝壳管理平台
// 功能: GitLab CI 的 Jenkins 替代版本，适合已有 Jenkins 基础设施的团队
// ============================================================
pipeline {
    agent any

    environment {
        DOCKER_REGISTRY = 'harbor.beike.com'
        DOCKER_IMAGE    = "${DOCKER_REGISTRY}/beike-admin"
        KUBE_NAMESPACE  = 'beike-admin'
        SONAR_HOST      = 'https://sonarqube.beike.com'
    }

    parameters {
        choice(name: 'DEPLOY_ENV', choices: ['staging', 'production'], description: '部署目标')
        choice(name: 'DEPLOY_STRATEGY', choices: ['rolling', 'blue-green', 'canary'], description: '部署策略')
        booleanParam(name: 'RUN_TESTS', defaultValue: true)
        booleanParam(name: 'RUN_SCAN', defaultValue: true)
    }

    stages {
        stage('Checkout') {
            steps { checkout scm }
        }

        stage('Lint & Build') {
            parallel {
                stage('Frontend') {
                    steps {
                        sh '''#!/bin/bash
                            corepack enable && pnpm install --frozen-lockfile
                            pnpm run lint || true
                            npx tsc --noEmit
                        '''
                    }
                }
                stage('Backend') {
                    steps {
                        sh 'cd backend && mvn clean compile -DskipTests'
                    }
                }
            }
        }

        stage('Test') {
            when { expression { params.RUN_TESTS } }
            parallel {
                stage('Unit Tests') {
                    steps {
                        sh 'cd backend && mvn test -Dspring.profiles.active=test'
                    }
                    post {
                        always {
                            junit 'backend/**/target/surefire-reports/*.xml'
                        }
                    }
                }
                stage('SonarQube') {
                    steps {
                        withSonarQubeEnv('SonarQube') {
                            sh 'mvn sonar:sonar -Dsonar.projectKey=beike-admin'
                        }
                    }
                }
            }
        }

        stage('Docker Build & Push') {
            steps {
                script {
                    docker.withRegistry("https://${DOCKER_REGISTRY}", 'harbor-cred') {
                        def app = docker.build("${DOCKER_IMAGE}:${env.BUILD_NUMBER}",
                            "--build-arg VITE_APP_VERSION=${env.BUILD_NUMBER} -f docker/Dockerfile .")
                        app.push()
                        app.push('latest')
                    }
                }
            }
        }

        stage('Security Scan') {
            when { expression { params.RUN_SCAN } }
            steps {
                sh "trivy image --severity HIGH,CRITICAL --no-progress ${DOCKER_IMAGE}:${env.BUILD_NUMBER}"
            }
        }

        stage('Deploy') {
            steps {
                script {
                    switch (params.DEPLOY_STRATEGY) {
                        case 'blue-green':
                            deployBlueGreen()
                            break
                        case 'canary':
                            deployCanary()
                            break
                        default:
                            deployRolling()
                    }
                }
            }
        }
    }

    post {
        success {
            dingtalk(
                robot: 'beike-robot',
                type: 'MARKDOWN',
                title: '✅ 部署成功',
                text: [
                    "# 贝壳管理平台部署成功",
                    "- 版本: ${env.BUILD_NUMBER}",
                    "- 环境: ${params.DEPLOY_ENV}",
                    "- 策略: ${params.DEPLOY_STRATEGY}",
                    "- 镜像: ${DOCKER_IMAGE}:${env.BUILD_NUMBER}"
                ].join('\n')
            )
        }
        failure {
            dingtalk(
                robot: 'beike-robot',
                type: 'MARKDOWN',
                title: '❌ 部署失败',
                text: [
                    "# 贝壳管理平台部署失败",
                    "- 版本: ${env.BUILD_NUMBER}",
                    "- 阶段: ${env.STAGE_NAME}",
                    "- [查看日志](${env.BUILD_URL})"
                ].join('\n')
            )
        }
    }
}

// ============================
// 蓝绿部署
// ============================
def deployBlueGreen() {
    sh '''#!/bin/bash
        ACTIVE=$(kubectl get svc beike-web -n ${KUBE_NAMESPACE} -o jsonpath="{.spec.selector.version}" 2>/dev/null || echo "blue")
        NEW=$([ "$ACTIVE" = "blue" ] && echo "green" || echo "blue")
        echo "→ Active: $ACTIVE, Deploying: $NEW"

        sed "s|IMAGE_TAG|${BUILD_NUMBER}|g" ci-cd/k8s-deploy/blue-green/deployment-${NEW}.yml | \
          kubectl apply -n ${KUBE_NAMESPACE} -f -

        kubectl rollout status deployment/beike-web-${NEW} -n ${KUBE_NAMESPACE} --timeout=5m

        # 健康检查
        for i in {1..10}; do
          STATUS=$(kubectl get pods -n ${KUBE_NAMESPACE} -l version=${NEW} -o jsonpath="{.items[0].status.phase}")
          [ "$STATUS" = "Running" ] && break
          sleep 5
        done

        kubectl patch svc beike-web -n ${KUBE_NAMESPACE} \
          -p "{\\"spec\\":{\\"selector\\":{\\"app\\":\\"beike-web\\",\\"version\\":\\"${NEW}\\"}}}"
        echo "Blue-Green switched to: $NEW"
    '''
}

// ============================
// 金丝雀部署 (Argo Rollouts)
// ============================
def deployCanary() {
    sh '''#!/bin/bash
        sed "s|IMAGE_TAG|${BUILD_NUMBER}|g" ci-cd/k8s-deploy/canary/rollout.yml | \
          kubectl apply -n ${KUBE_NAMESPACE} -f -

        # 10% → 30% → 60% → 100%
        for pct in 10 30 60 100; do
          echo "→ Canary ${pct}%"
          kubectl argo rollouts set weight beike-web ${pct} -n ${KUBE_NAMESPACE} || true
          sleep 120  # 观察 2 分钟
        done
        kubectl argo rollouts promote --full beike-web -n ${KUBE_NAMESPACE}
    '''
}
